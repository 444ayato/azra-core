<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Form Pengajuan Proyek Desa"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:textColor="#0096FF" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNamaProyek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lokasi / Proyek Desa" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWaktuReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Set Waktu Pengingat (Menit)"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnKirimPengajuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kirim &amp; Aktifkan Pengingat"
        android:backgroundTint="#0096FF" />

</LinearLayout>